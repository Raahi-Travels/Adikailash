# Copy to .env and fill in. Never commit the real file.
#
# This is the SHARED Raahi Supabase database. Schema ownership:
#   public  -> Raahi intercity cab app (31 tables) + better-auth. NOT OURS.
#   auth    -> Supabase Auth (GoTrue). NOT OURS.
#   yatra   -> this project. The only schema we create or alter.
#
# Two URLs because the pooler runs in two modes:
#   6543 transaction pooling  -> app queries. No prepared statements; asyncpg is
#                                configured with statement caches disabled in db.py.
#   5432 session pooling      -> Alembic migrations, which need a real session.

DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

DB_SCHEMA=yatra

# Document storage. S3 access keys (Storage-scoped), never the service_role key.
S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
DOCUMENT_BUCKET=traveller-documents
